# Copy to .env and fill in. Never commit .env.

# Postgres connection string (Supabase or Neon)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Location to forecast. Default is Jakarta.
LATITUDE=-6.2088
LONGITUDE=106.8456
LOCATION_NAME=Jakarta

# How many hours of history the model sees, and how far ahead it predicts
LOOKBACK_HOURS=168
HORIZON_HOURS=24

# Where the active model artifact lives
MODEL_DIR=models
